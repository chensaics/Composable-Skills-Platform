{
  "name": "csp-core",
  "version": "0.12.0",
  "description": "CSP — Composable Skills Platform. The AI capability operating system for one-person companies and independent builders. Federal routing + 5-layer architecture + 12-domain coverage.",
  "fullName": "Composable Skills Platform (CSP)",
  "author": "maythyai",
  "repository": "https://github.com/maythyai/code-skills-package",
  "homepage": "https://maythyai.github.io/code-skills-package/",
  "keywords": ["skills", "agent-skills", "claude-code", "ai", "programming", "federation"],
  "install": {
    "npx": "npx skills add maythyai/code-skills-package -g",
    "claude": "/plugin marketplace add maythyai/code-skills-package",
    "manual": "git clone https://github.com/maythyai/code-skills-package.git && ./install.sh",
    "clawhub": "clawhub install csp-core",
    "hermes": "./sync.sh && cp -r .agents/skills/* ~/.hermes/skills/"
  },
  "federation": {
    "router": "csp-router/federation.yaml",
    "sub_packages": ["@csp/creator", "@csp/business", "@csp/life"]
  }
}